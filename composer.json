{
    "name": "enricodias/email-validator",
    "type": "library",
    "license": "MIT",
    "description": "Validate and check for disposable/temporary/throw away emails using multiple providers",
    "keywords": ["email", "disposable", "temporary email", "throw away email", "email validator"],
    "authors": [
        {
            "name": "Enrico Dias",
            "email": "enrico@enricodias.com"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": ">=7.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "php-http/discovery": "^1.14"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Recommended PSR-18 HTTP client implementation (^7.0, also provides PSR-17 factories via guzzlehttp/psr7 ^2.0).",
        "guzzlehttp/psr7": "Recommended PSR-17 HTTP factories implementation (^2.0)."
    },
    "autoload": {
        "psr-4": {
            "enricodias\\EmailValidator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "enricodias\\EmailValidator\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "codacy/coverage": "^1.4",
        "phpunit/phpunit": "^8.5 || ^9.0",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0"
    }
}
